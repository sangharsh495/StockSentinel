# ============================================================
# StockSentinel Backend Environment Variables
# Copy this file to .env and fill in your credentials.
# ============================================================

# 1. PostgreSQL Database (Neon.tech Serverless Postgres recommended)
# Format: postgresql://[user]:[password]@[host]/[database]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. Google Gemini API (Get free API key at https://aistudio.google.com/)
# Used for AI financial research reports, deep-dive thesis, and earnings catalysts
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Groq Cloud API (Get free ultra-fast Llama-3 API key at https://console.groq.com/)
# Used as high-speed primary/fallback LLM for instant news impact rating and IPO research
GROQ_API_KEY=your_groq_api_key_here

# 4. Finnhub Stock API (Free at https://finnhub.io/)
# Used for US market quotes, company profile, and global news fallback
FINNHUB_API_KEY=your_finnhub_api_key_here

# 5. Firebase Admin SDK (Optional - for real-time mobile push notifications)
# Either:
#   A) Path to service account JSON: ./firebase-credentials.json
#   B) Base64 encoded service account JSON string
FIREBASE_CREDENTIALS=

# 6. Render External URL (Optional - for Render.com free-tier deployment)
# Used by APScheduler self-ping task to prevent 15-minute cold sleep
RENDER_EXTERNAL_URL=https://stocksentinel-api.onrender.com

# 7. Server Environment
# Set to 'true' for verbose development logs, 'false' for production
DEBUG=true
