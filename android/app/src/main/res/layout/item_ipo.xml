<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/card_dark"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/ipo_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:text="NovaTech Solutions Ltd" />

            <TextView
                android:id="@+id/ipo_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/green_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_dark"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="OPEN" />
        </LinearLayout>

        <TextView
            android:id="@+id/ipo_dates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:text="12 Jan 2026 – 14 Jan 2026" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/ipo_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="₹450 - ₹475" />

            <TextView
                android:id="@+id/ipo_lot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:text="Lot: 30 shares" />

            <TextView
                android:id="@+id/ipo_gmp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/badge_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/yellow_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:text="GMP: +₹145" />

            <TextView
                android:id="@+id/ipo_btn_report"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_dark"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/purple_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:text="AI Report ➔" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
