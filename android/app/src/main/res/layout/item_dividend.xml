<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/card_dark"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top row: Symbol, Rating Badge, Amount -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/div_symbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="TCS" />

            <TextView
                android:id="@+id/div_rating_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_dark"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/purple_accent"
                android:textSize="10sp"
                android:textStyle="bold"
                android:text="HIGH YIELD" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/div_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/green_accent"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="₹28.00" />
        </LinearLayout>

        <!-- Company Name & Price -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/div_company"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Tata Consultancy Services" />

            <TextView
                android:id="@+id/div_stock_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:text="₹3,450.00" />
        </LinearLayout>

        <!-- Bottom row: Ex-date, Yield, Consistency Stars, Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/div_ex_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:text="Ex: 24 Jan 2026" />

            <!-- Yield -->
            <TextView
                android:id="@+id/div_yield"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_dark"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="@color/blue_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:text="3.2% Yield" />

            <!-- Consistency Rating Stars -->
            <TextView
                android:id="@+id/div_rating_stars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/yellow_accent"
                android:textSize="11sp"
                android:text="★★★★☆" />

            <!-- Status -->
            <TextView
                android:id="@+id/div_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/blue_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:text="UPCOMING" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
