<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_ai_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Row: Symbol & Trend Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/mover_symbol"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SYMBOL"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mover_trend_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_dark"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="BULLISH"
            android:textColor="@color/green_accent"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Company Name -->
    <TextView
        android:id="@+id/mover_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Company Name"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Catalyst Badge -->
    <TextView
        android:id="@+id/mover_catalyst_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#207C4DFF"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:text="Order Win"
        android:textColor="@color/purple_accent"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Reason text -->
    <TextView
        android:id="@+id/mover_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="High buying momentum expected due to major contract win."
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:lineSpacingMultiplier="1.1" />

    <!-- Price & Change Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/mover_price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="₹0.00"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mover_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+0.0%"
            android:textColor="@color/green_accent"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
