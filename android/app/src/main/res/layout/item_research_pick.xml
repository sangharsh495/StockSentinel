<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/card_dark"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Research Grade Badge -->
        <TextView
            android:id="@+id/pick_grade"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="A+"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:background="@drawable/bg_pill_dark" />

        <!-- Stock Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/pick_symbol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RELIANCE"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pick_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Strong Buy"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#FF00E676"
                    android:background="@drawable/bg_pill_dark"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/pick_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2 extreme catalysts in last 72h"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/pick_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Score: 87.5"
                android:textColor="@color/purple_accent"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Price Column -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/pick_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹2,450.00"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pick_change"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+3.45%"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
